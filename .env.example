# Copy values into ignored .env.local. Never commit credentials.
DATABASE_URL=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Runtime application pool (default 1; integer 1–10).
DATABASE_POOL_MAX=1
# Optional trusted server root CA file from Supabase Database Settings.
DATABASE_SSL_CA_FILE=
